#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer definitions for readability

#define BASE   0
#define NAV    1
#define BT     2
#define SCROLL 3
#define SNIPE  4

// Configure layer-tap behavior

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

// Configure mod-tap behavior (used for Ctrl/Esc and Shift/Backspace)

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // ============================================================
        // MOUSE CLICKS — left home row (point with right trackball,
        //                                click with left hand)
        // ============================================================
        // Left click: I + E in BÉPO (D + F in QWERTY)

        combo_lclick {
            timeout-ms = <40>;
            key-positions = <27 28>;
            bindings = <&mkp LCLK>;
            layers = <BASE NAV SCROLL SNIPE>;
        };

        // Right click: U + I in BÉPO (S + D in QWERTY)

        combo_rclick {
            timeout-ms = <40>;
            key-positions = <26 27>;
            bindings = <&mkp RCLK>;
            layers = <BASE NAV SCROLL SNIPE>;
        };

        // Middle click: U + I + E in BÉPO (S + D + F in QWERTY)

        combo_mclick {
            timeout-ms = <40>;
            key-positions = <26 27 28>;
            bindings = <&mkp MCLK>;
            layers = <BASE NAV SCROLL SNIPE>;
        };

        // ============================================================
        // TRACKBALL MODES — hold combo to activate, release to return
        // ============================================================
        // Scroll mode: E + , in BÉPO (F + G in QWERTY)

        combo_scroll {
            timeout-ms = <50>;
            key-positions = <16 15>;
            bindings = <&mo SCROLL>;
            layers = <BASE>;
        };

        // Snipe mode: A + U in BÉPO (A + S in QWERTY)

        combo_snipe {
            timeout-ms = <50>;
            key-positions = <25 26>;
            bindings = <&mo SNIPE>;
            layers = <BASE>;
        };

        // ============================================================
        // UTILITY COMBOS
        // ============================================================
        // BT layer: outer left pinky column (Ctrl/Esc + LShift)
        // Rarely used — buried on purpose

        combo_bt {
            timeout-ms = <40>;
            key-positions = <24 36>;
            bindings = <&mo BT>;
            layers = <BASE>;
        };

        // CapsLock: both shift positions simultaneously

        combo_capslock {
            timeout-ms = <50>;
            key-positions = <36 51>;
            bindings = <&kp CAPSLOCK>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =================================================================
        // LAYER 0: BASE (QWERTY keycodes, interpreted as BÉPO by Ubuntu)
        //
        // BÉPO:  ESC  "   «   »   (   )      @   +   -   /   *  PRTSC
        //        TAB  B   É   P   O   È      ^   V   D   L   J   Z
        //  Ctrl/Esc A  U   I   E   ,          C   T   S   R   N   M
        //       LSh  À   Y   X   .   K       '   Q   G   H   F  DEL
        //                SPC mo1 LCtrl    Sh/BkSp Enter
        //                    LWin RAlt     BkSp
        // =================================================================

        QWERTY {
            bindings = <
&kp ESC           &kp N1  &kp N2  &kp N3     &kp N4     &kp N5          &kp N6         &kp N7         &kp N8     &kp N9   &kp N0    &kp PRINTSCREEN
&kp TAB           &kp Q   &kp W   &kp E      &kp R      &kp T           &kp Y          &kp U          &kp I      &kp O    &kp P     &kp BSLH
&kp LEFT_SHIFT    &kp A   &kp S   &kp D      &kp F      &kp G           &kp H          &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C      &kp V      &kp B           &kp N          &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp DELETE
                                  &kp SPACE  &mo NAV    &kp LEFT_GUI    &kp RSHIFT     &kp BACKSPACE
                                             &kp ENTER  &kp LEFT_ALT    &kp RIGHT_ALT
            >;
        };

        // =================================================================
        // LAYER 1: NAV + MODIFIERS (hold left thumb MO key)
        //
        // Left hand = modifiers + shortcuts (combine with right hand nav)
        //   Home row: GUI, ALT, CTRL, SHIFT
        //   Bottom:   Undo, Cut, Copy, Paste
        //
        // Right hand = navigation
        //   Arrow keys, PgUp/PgDn, Home/End
        //
        // Examples from home position:
        //   Ctrl+Right = jump word    |  Shift+Right = select right
        //   Ctrl+Shift+Left = select word left
        //   Ctrl+A = select all       |  Ctrl+Z = undo
        // =================================================================

        NAV {
            bindings = <
&kp F1  &kp F2     &kp F3     &kp F4     &kp F5      &kp F6       &kp F7  &kp F8          &kp F9          &kp F10          &kp F11           &kp F12
&trans  &none      &none      &none      &none       &none        &none   &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &kp MINUS         &kp EQUAL
&trans  &kp LGUI   &kp LALT   &kp LCTRL  &kp LSHIFT  &none        &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)   &none        &none   &kp HOME        &none           &kp END          &none             &kp DELETE
                              &mkp LCLK  &trans      &mkp RCLK    &trans  &trans
                                         &trans      &trans       &trans
            >;
        };

        // =================================================================
        // LAYER 2: BLUETOOTH (accessed via combo: Ctrl/Esc + LShift)
        // =================================================================

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        // =================================================================
        // LAYER 3: SCROLL (trackball becomes scroll wheel)
        // Accessed via combo: E + , in BÉPO (F + G in QWERTY)
        // Hold the combo, scroll with trackball, release to return
        // =================================================================

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        // =================================================================
        // LAYER 4: SNIPE (trackball moves at reduced DPI for precision)
        // Accessed via combo: A + U in BÉPO (A + S in QWERTY)
        // Hold the combo, fine-point with trackball, click via combos
        // =================================================================

        snipe_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };
    };
};
